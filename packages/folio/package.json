{
  "name": "@uichat-mira/folio",
  "version": "0.1.0",
  "description": "Git-native documentation, publishing, and project portal runtime",
  "keywords": [
    "documentation",
    "markdown",
    "vite",
    "react",
    "github-pages",
    "static-site-generator",
    "cms"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "./dist/styles.css"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js",
      "default": "./dist/vite.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "scripts": {
    "build": "tsup src/index.ts src/vite.ts --format esm --dts --clean && node scripts/copy-styles.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.mjs",
    "prepack": "npm run build",
    "pack:verify": "node scripts/verify-package.mjs"
  },
  "dependencies": {
    "marked": "^15.0.12",
    "yaml": "^2.8.1",
    "highlight.js": "^11.11.1",
    "mermaid": "^11.16.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.0",
    "vite": "^7.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.18.1",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.2"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/uichat-mira/folio.git",
    "directory": "packages/folio"
  },
  "homepage": "https://uichat-mira.github.io/folio/",
  "bugs": {
    "url": "https://github.com/uichat-mira/folio/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "license": "MIT"
}
