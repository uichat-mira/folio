{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uichat-mira.github.io/folio/schemas/config.schema.json",
  "title": "Folio Configuration",
  "type": "object",
  "required": ["title", "description"],
  "properties": {
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "logo": { "type": "string" },
    "siteUrl": { "type": "string" },
    "base": { "type": "string" },
    "github": { "type": "string" },
    "footer": { "type": "string" },
    "navigation": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["label", "href"],
        "properties": {
          "label": { "type": "string" },
          "href": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
