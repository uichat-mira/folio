{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uichat-mira.github.io/folio/schemas/config.schema.json",
  "title": "Folio Configuration",
  "type": "object",
  "required": [
    "title",
    "description"
  ],
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "logo": {
      "type": "string"
    },
    "siteUrl": {
      "type": "string"
    },
    "base": {
      "type": "string"
    },
    "github": {
      "type": "string"
    },
    "footer": {
      "type": "string"
    },
    "navigation": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "label",
          "href"
        ],
        "properties": {
          "label": {
            "type": "string"
          },
          "href": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "collections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path"
        ],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^/"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "emptyMessage": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "home": {
      "type": "object",
      "properties": {
        "meta": {
          "oneOf": [
            {
              "const": false
            },
            {
              "type": "object",
              "properties": {
                "left": {
                  "type": "string"
                },
                "right": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          ]
        },
        "sections": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "object",
                "required": [
                  "type"
                ],
                "properties": {
                  "type": {
                    "const": "intro"
                  },
                  "collection": {
                    "type": "string"
                  },
                  "title": {
                    "type": "string"
                  },
                  "description": {
                    "type": "string"
                  },
                  "kicker": {
                    "type": "string"
                  }
                },
                "additionalProperties": false
              },
              {
                "type": "object",
                "required": [
                  "type"
                ],
                "properties": {
                  "type": {
                    "const": "featured"
                  },
                  "collection": {
                    "type": "string"
                  },
                  "path": {
                    "type": "string"
                  },
                  "label": {
                    "type": "string"
                  },
                  "readLabel": {
                    "type": "string"
                  }
                },
                "additionalProperties": false
              },
              {
                "type": "object",
                "required": [
                  "type"
                ],
                "properties": {
                  "type": {
                    "const": "recent"
                  },
                  "collection": {
                    "type": "string"
                  },
                  "limit": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "title": {
                    "type": "string"
                  },
                  "label": {
                    "type": "string"
                  },
                  "emptyMessage": {
                    "type": "string"
                  },
                  "endMessage": {
                    "type": "string"
                  }
                },
                "additionalProperties": false
              },
              {
                "type": "object",
                "required": [
                  "type"
                ],
                "properties": {
                  "type": {
                    "const": "collections"
                  },
                  "paths": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "limit": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "emptyMessage": {
                    "type": "string"
                  }
                },
                "additionalProperties": false
              },
              {
                "type": "object",
                "required": [
                  "type"
                ],
                "properties": {
                  "type": {
                    "const": "about"
                  },
                  "path": {
                    "type": "string"
                  },
                  "title": {
                    "type": "string"
                  },
                  "description": {
                    "type": "string"
                  },
                  "linkLabel": {
                    "type": "string"
                  }
                },
                "additionalProperties": false
              }
            ]
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
